{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current file (stdin = input/<bai>.txt)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python",
      "stdin": "${workspaceFolder}/input/${fileBasenameNoExtension}.txt"
    }
  ]
}
